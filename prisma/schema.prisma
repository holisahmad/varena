// VARENA Direct Selling & Multilevel Marketing Platform
// Prisma Schema - Strict ACID compliance & auditability

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// 1. Identity & RBAC
// -------------------------------------------------------------

model User {
  id              String      @id @default(uuid())
  email           String      @unique
  phone           String?     @unique
  passwordHash    String
  displayName     String
  status          String      @default("ACTIVE") // ACTIVE, SUSPENDED, TERMINATED
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  userRoles       UserRole[]
  member          Member?
  orders          Order[]
  auditLogs       AuditLog[]

  @@map("users")
}

model Role {
  id          String     @id @default(uuid())
  code        String     @unique // OWNER, KOPERASI, OPERATIONS, ADMIN_1, ADMIN_2, LEADER_1, LEADER_2, LEADER_3, MITRA, CONSUMER, AUDITOR
  name        String
  description String?
  userRoles   UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

// -------------------------------------------------------------
// 2. Member & Network (Sponsor vs. Placement)
// -------------------------------------------------------------

model Member {
  id           String    @id @default(uuid())
  userId       String    @unique
  memberCode   String    @unique // e.g. VRN-0001
  displayName  String
  legalName    String
  nik          String?
  memberStatus String    @default("ACTIVE") // PENDING, ACTIVE, SUSPENDED, TERMINATED
  kycStatus    String    @default("VERIFIED") // PENDING, VERIFIED, REJECTED

  // Bound Bank Account for Secure Payouts
  bankName             String?
  bankAccountNumber    String?
  bankAccountHolder    String?
  bankLockedAt         DateTime?

  // Regional Stockist Hub Support (Legacy)
  stockistType         String    @default("NONE") // NONE, MOBILE, MASTER
  stockistCity         String?   // e.g. Surabaya, Medan, Makassar
  stockistInventory    Int       @default(0)      // Current box quota in stockist custody

  // Official Regional Agent (Direct Selling Keagenan Resmi)
  isAgent                  Boolean   @default(false)
  agentType                String    @default("NONE") // NONE, REGIONAL_AGENT, MASTER_AGENT
  agentCity                String?
  agentProvince            String?
  agentAddress             String?
  agentInventory           Int       @default(0)      // Kuota stok fisik box di tangan agen
  agentDepositBalance      Int       @default(0)      // Saldo deposit kas agen
  agentDiscountType        String    @default("PERCENTAGE") // PERCENTAGE or FLAT_PER_BOX
  agentDiscountValue       Float     @default(15.0)   // Nilai diskon: 15% atau Rp50.000
  agentStatus              String    @default("NONE") // NONE, APPLIED, ACTIVE, SUSPENDED
  agentVerifiedAt          DateTime?

  // Saldo Deposit Belanja Mitra
  shoppingDepositBalance   Int       @default(0)      // Saldo deposit untuk belanja mitra

  // Alamat Pengiriman Tersimpan (Default Structured Shipping Address)
  recipientName        String?
  recipientPhone       String?
  province             String?
  city                 String?
  district             String?   // Kecamatan
  postalCode           String?
  addressDetail        String?   // Jalan, RT/RW, No. Rumah

  // Akumulasi Kode Unik Tersimpan (Dapat ditarik jika terkumpul minimal Rp10.000)
  uniqueCodeBalance    Int       @default(0)

  joinedAt     DateTime  @default(now())
  activatedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relationships
  sponsorRel            SponsorRelationship?   @relation("SponsorSelf")
  sponsoredMembers      SponsorRelationship[]  @relation("SponsorUpline")
  
  placementRel          PlacementRelationship? @relation("PlacementSelf")
  placedChildren        PlacementRelationship[] @relation("PlacementParent")
  
  placementHistories       PlacementHistory[]
  commissionsEarned        CommissionItem[]          @relation("CommissionBeneficiary")
  ledgerAccounts           LedgerAccount[]
  withdrawalRequests       WithdrawalRequest[]
  referredOrders           Order[]                   @relation("ReferredOrders")
  assignedAgentOrders      Order[]                   @relation("AssignedAgentOrders")
  agentApplications        AgentApplication[]
  agentDepositTransactions AgentDepositTransaction[]
  agentStockMutations      AgentStockMutation[]
  agentRewards             AgentReward[]

  @@index([memberStatus])
  @@index([stockistType])
  @@index([isAgent])
  @@index([agentCity])
  @@map("members")
}

model SponsorRelationship {
  id              String   @id @default(uuid())
  memberId        String   @unique
  sponsorMemberId String
  reason          String?  @default("INITIAL_REGISTRATION")
  createdBy       String?
  createdAt       DateTime @default(now())

  member  Member @relation("SponsorSelf", fields: [memberId], references: [id], onDelete: Cascade)
  sponsor Member @relation("SponsorUpline", fields: [sponsorMemberId], references: [id], onDelete: Restrict)

  @@index([sponsorMemberId])
  @@map("sponsor_relationships")
}

model PlacementRelationship {
  id             String    @id @default(uuid())
  memberId       String    @unique // Exactly 1 active parent node
  parentMemberId String
  status         String    @default("ACTIVE") // ACTIVE, TRANSFERRED
  effectiveFrom  DateTime  @default(now())
  effectiveTo    DateTime?
  createdBy      String?
  approvedBy     String?
  createdAt      DateTime  @default(now())

  member Member @relation("PlacementSelf", fields: [memberId], references: [id], onDelete: Cascade)
  parent Member @relation("PlacementParent", fields: [parentMemberId], references: [id], onDelete: Restrict)

  @@index([parentMemberId, status])
  @@map("placement_relationships")
}

model PlacementHistory {
  id          String   @id @default(uuid())
  memberId    String
  oldParentId String?
  newParentId String
  effectiveAt DateTime @default(now())
  reason      String
  requestedBy String
  approvedBy  String
  createdAt   DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, effectiveAt])
  @@map("placement_histories")
}

// -------------------------------------------------------------
// 3. Catalog, Inventory & Orders
// -------------------------------------------------------------

model Product {
  id                String           @id @default(uuid())
  name              String
  slug              String           @unique
  description       String
  tagline           String?          // e.g. "Energi Pagi, Sehat Seharian"
  servingSuggestion String?          // Panduan takaran & cara penyajian
  category          String           @default("PREMIUM_COFFEE")
  status            String           @default("ACTIVE") // DRAFT, ACTIVE, ARCHIVED
  isFeatured        Boolean          @default(false)
  bpomNumber        String?          // Izin Edar P-IRT atau BPOM
  halalNumber       String?          // Sertifikat Halal
  imageUrl          String?
  launchedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  variants ProductVariant[]

  @@map("products")
}

model ProductVariant {
  id                   String      @id @default(uuid())
  productId            String
  sku                  String      @unique
  name                 String
  variantType          String      @default("PACK") // PACK (Box/Paket) or SINGLE (Satuan/Sachet/Eceran)
  packSize             Int         @default(10) // 10 sachet per box atau 1 untuk satuan
  unit                 String      @default("box") // box, sachet, botol, pouch, pcs
  price                Int         // Harga Jual Konsumen/Mitra (IDR)
  hpp                  Int         // Harga Pokok Penjualan (HPP)
  stockQuantity        Int         @default(1000)
  status               String      @default("ACTIVE") // ACTIVE, INACTIVE
  allowFirstPack       Boolean     @default(true) // Sah untuk paket perdana kemitraan
  allowRepeatOrder     Boolean     @default(true) // Sah untuk belanja ulang (repeat purchase)
  allowAgentStock      Boolean     @default(true) // Sah untuk pasokan stokis/agen
  sponsorReward        Int         @default(50000) // Nilai bonus sponsor langsung untuk varian ini
  uplineRewardPerLevel Int         @default(10000) // Nilai bonus pembinaan jaringan per level
  maxCommissionLevels  Int         @default(10) // Maksimal level komisi pembinaan (1-10)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@map("product_variants")
}

model Order {
  id                     String    @id @default(uuid())
  orderNumber            String    @unique // e.g. ORD-20261113-0001
  buyerUserId            String?
  buyerName              String
  buyerPhone             String
  buyerEmail             String?
  shippingAddress        String
  referralMemberId       String?
  orderStatus            String    @default("PENDING_PAYMENT") // PENDING_PAYMENT, PAID, PROCESSING, SHIPPED, COMPLETED, CANCELLED, REFUNDED
  orderType              String    @default("FIRST_PACK") // FIRST_PACK, REPEAT_PURCHASE
  subtotal               Int
  discount               Int       @default(0)
  shippingCost           Int       @default(0)
  shippingExpense        Int       @default(0) // Biaya ongkir ditanggung kantor (misal pengiriman pasokan ke stokis)
  uniqueCode             Int       @default(0) // Kode unik 3 digit (misal 100 - 999) untuk konfirmasi otomatis bank
  total                  Int
  currency               String    @default("IDR")
  marketingPlanVersionId String?
  paidAt                 DateTime?
  courierName            String?   // e.g. JNE, J&T, SiCepat, Pos Indonesia
  trackingNumber         String?   // e.g. JNE-88291024-ID
  warehouseOriginName    String?   @default("Gudang Pusat VARENA") // Nama gudang pengirim
  warehouseOriginCity    String?   @default("Jakarta")             // Kota gudang pengirim
  fulfillmentSource      String    @default("CENTRAL_WAREHOUSE") // CENTRAL_WAREHOUSE, REGIONAL_STOCKIST, REGIONAL_AGENT
  stockistMemberId       String?   // (Legacy) null if central warehouse, or memberId of the stockist hub
  
  // Agent Routing & Regional Distribution
  assignedAgentMemberId  String?   // ID Member Agent yang ditugaskan menangani pengiriman
  fulfillmentMode        String?   @default("CENTRAL") // CENTRAL, ASSIGNED_AGENT, AGENT_DROPSHIP_REQUEST
  agentDispatchStatus    String?   @default("NONE") // NONE, ASSIGNED, PACKING, DISPATCHED, COMPLETED
  agentNote              String?   // Catatan koordinasi agen & kantor pusat

  shippedAt              DateTime?
  completedAt            DateTime?

  // Alamat Pengiriman Terstruktur
  shippingProvince       String?
  shippingCity           String?
  shippingDistrict       String?   // Kecamatan
  shippingPostalCode     String?
  shippingNotes          String?

  // Konfirmasi Transfer Manual & Upload Bukti (jika salah transfer/salah kode unik)
  paymentProofUrl             String?   // URL / base64 foto bukti transfer
  senderBankName              String?   // Bank asal pengirim
  senderAccountName           String?   // Nama pemilik rekening pengirim
  transferAmountPaid          Int?      // Nominal riil yang ditransfer member
  transferNotes               String?   // Catatan transfer dari member
  paymentConfirmationStatus   String?   @default("NONE") // NONE, SUBMITTED, VERIFIED, REJECTED

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  buyerUser           User?           @relation(fields: [buyerUserId], references: [id], onDelete: SetNull)
  referralMember      Member?         @relation("ReferredOrders", fields: [referralMemberId], references: [id], onDelete: SetNull)
  assignedAgentMember Member?         @relation("AssignedAgentOrders", fields: [assignedAgentMemberId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  payments            Payment[]
  commissionRuns      CommissionRun[]

  @@index([orderStatus, paidAt])
  @@index([referralMemberId])
  @@index([assignedAgentMemberId])
  @@index([createdAt])
  @@index([buyerUserId, createdAt])
  @@index([paymentConfirmationStatus])
  @@index([shippingCity, orderStatus])
  @@index([buyerPhone])
  @@map("orders")
}

model OrderItem {
  id               String @id @default(uuid())
  orderId          String
  productVariantId String
  skuSnapshot      String
  nameSnapshot     String
  unitPrice        Int
  hppSnapshot      Int
  quantity         Int
  lineTotal        Int

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id                String    @id @default(uuid())
  orderId           String
  provider          String    @default("MANUAL_TRANSFER") // MANUAL_TRANSFER, MIDTRANS, XENDIT, SIMULATED
  providerReference String?
  amount            Int
  status            String    @default("PENDING") // PENDING, SUCCESS, FAILED
  paidAt            DateTime?
  webhookEventId    String?   @unique
  createdAt         DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payments")
}

// -------------------------------------------------------------
// 4. Marketing Plan & Commission Engine
// -------------------------------------------------------------

model MarketingPlan {
  id                         String    @id @default(uuid())
  planCode                   String    @unique // e.g. MP-2026-V1
  version                    Int       @default(1)
  name                       String
  status                     String    @default("ACTIVE") // DRAFT, ACTIVE, RETIRED
  firstPackDirectReward      Int       @default(50000)
  firstPackDevReward         Int       @default(10000)
  firstPackDevMaxLevels      Int       @default(10)
  repeatDevReward            Int       @default(1000) // Rp1.000 / sachet baseline
  repeatDevMaxLevels         Int       @default(10)
  effectiveFrom              DateTime  @default(now())
  effectiveTo                DateTime?
  createdBy                  String
  approvedBy                 String?
  approvalReference          String?
  createdAt                  DateTime  @default(now())

  commissionRuns CommissionRun[]

  @@map("marketing_plans")
}

model CommissionRun {
  id                 String   @id @default(uuid())
  sourceOrderId      String
  planVersionId      String
  calculationStatus  String   @default("COMPLETED") // PENDING, COMPLETED, FAILED, REVERSED
  idempotencyKey     String   @unique
  totalCommission    Int      @default(0)
  unallocatedAmount  Int      @default(0)
  inputSnapshot      String?  // JSON stringified input
  startedAt          DateTime @default(now())
  completedAt        DateTime @default(now())

  order Order         @relation(fields: [sourceOrderId], references: [id], onDelete: Cascade)
  plan  MarketingPlan @relation(fields: [planVersionId], references: [id], onDelete: Restrict)

  items CommissionItem[]

  @@map("commission_runs")
}

model CommissionItem {
  id                  String   @id @default(uuid())
  commissionRunId     String
  beneficiaryMemberId String?  // Null if unallocated
  rewardType          String   // DIRECT_SPONSOR, DEVELOPMENT_PLACEMENT, UNALLOCATED_DEV_RESERVE
  levelNumber         Int      @default(0)
  amount              Int      // IDR Integer
  status              String   @default("ELIGIBLE") // ELIGIBLE, HELD, APPROVED, PAID, REVERSED
  reasonCode          String?  // e.g. "DIRECT_SPONSOR_BONUS", "UPLINE_DEV_L1", "UNALLOCATED_L9_EMPTY"
  formulaSnapshot     String?
  createdAt           DateTime @default(now())

  commissionRun CommissionRun @relation(fields: [commissionRunId], references: [id], onDelete: Cascade)
  beneficiary   Member?       @relation("CommissionBeneficiary", fields: [beneficiaryMemberId], references: [id], onDelete: SetNull)

  @@index([beneficiaryMemberId, status])
  @@index([commissionRunId])
  @@map("commission_items")
}

// -------------------------------------------------------------
// 5. Double-Entry Ledger & Wallet
// -------------------------------------------------------------

model LedgerAccount {
  id          String   @id @default(uuid())
  ownerType   String   // MEMBER, COMPANY_OPERATIONS, COMPANY_UNALLOCATED_RESERVE, COMPANY_PAYOUT_CLEARING
  ownerId     String?  // memberId or company internal key
  accountCode String   @unique // e.g. ACC-MBR-VRN-0001, ACC-COMP-OPS
  accountType String   // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  currency    String   @default("IDR")
  balance     Int      @default(0)
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())

  member  Member?       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  entries LedgerEntry[]

  @@map("ledger_accounts")
}

model LedgerTransaction {
  id             String   @id @default(uuid())
  referenceType  String   // ORDER_PAYMENT, COMMISSION_CREDIT, WITHDRAWAL_HOLD, WITHDRAWAL_PAID, WITHDRAWAL_REVERSAL
  referenceId    String   // orderId, commissionRunId, withdrawalId
  transactionType String  // STANDARD, REVERSAL
  status         String   @default("POSTED") // POSTED, VOID
  idempotencyKey String   @unique
  memo           String
  postedAt       DateTime @default(now())
  createdAt      DateTime @default(now())

  entries LedgerEntry[]

  @@map("ledger_transactions")
}

model LedgerEntry {
  id            String   @id @default(uuid())
  transactionId String
  accountId     String
  direction     String   // DEBIT, CREDIT
  amount        Int      // IDR Integer > 0
  memo          String?
  createdAt     DateTime @default(now())

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account     LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([transactionId])
  @@map("ledger_entries")
}

// -------------------------------------------------------------
// 6. Withdrawal & Payout
// -------------------------------------------------------------

model WithdrawalRequest {
  id                   String    @id @default(uuid())
  memberId             String
  amount               Int       // requested amount
  fee                  Int       @default(0) // withdrawal administrative fee
  netAmount            Int       // amount to transfer
  bankName             String
  accountNumberMasked  String
  accountHolder        String
  status               String    @default("REQUESTED") // REQUESTED, UNDER_REVIEW, APPROVED, REJECTED, PAID, FAILED
  rejectionReason      String?
  providerReference    String?
  requestedAt          DateTime  @default(now())
  reviewedBy           String?
  reviewedAt           DateTime?
  paidAt               DateTime?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([status, requestedAt])
  @@index([memberId, status])
  @@index([requestedAt])
  @@map("withdrawal_requests")
}

// -------------------------------------------------------------
// 7. Security, Audit & Outbox
// -------------------------------------------------------------

model AuditLog {
  id            String   @id @default(uuid())
  actorUserId   String?
  action        String   // LOGIN, ORDER_CREATED, PLACEMENT_TRANSFER, COMMISSION_RUN, WITHDRAWAL_APPROVE, etc.
  entityType    String   // ORDER, MEMBER, COMMISSION, WITHDRAWAL
  entityId      String
  beforeJson    String?
  afterJson     String?
  reason        String?
  ipAddress     String?
  correlationId String?
  createdAt     DateTime @default(now())

  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// -------------------------------------------------------------
// 8. Official Regional Agent Hub (Direct Selling Distribution)
// -------------------------------------------------------------

model AgentApplication {
  id               String    @id @default(uuid())
  memberId         String
  city             String
  province         String
  warehouseAddress String
  storageCapacity  Int       @default(50) // Kapasitas tampung box
  contactPhone     String
  notes            String?
  status           String    @default("PENDING") // PENDING, UNDER_REVIEW, APPROVED, REJECTED
  rejectionReason  String?
  reviewedBy       String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([memberId])
  @@map("agent_applications")
}

model AgentDepositTransaction {
  id            String    @id @default(uuid())
  memberId      String
  type          String    // TOPUP_DEPOSIT, RESTOCK_PAYMENT, ADJUSTMENT_CREDIT, ADJUSTMENT_DEBIT, RESTOCK_HYBRID_DEPOSIT, SHOPPING_TOPUP, SHOPPING_PAYMENT
  amount        Int       // Nominal IDR
  balanceBefore Int       @default(0)
  balanceAfter  Int       @default(0)
  referenceId   String?   // orderNumber or bank reference
  notes         String?
  status        String    @default("COMPLETED") // PENDING, COMPLETED, REJECTED
  proofUrl      String?   // Bukti transfer bank jika topup
  approvedBy    String?   // User admin yang approve topup
  uniqueCode    Int       @default(0) // 3-digit unique code for transfer verification
  bankName      String?   // Bank pengirim dari agent/mitra
  accountNumber String?   // Nomor rekening pengirim
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt])
  @@index([status, createdAt])
  @@index([status])
  @@map("agent_deposit_transactions")
}

model AgentStockMutation {
  id            String    @id @default(uuid())
  memberId      String
  type          String    // RESTOCK_FROM_CENTRAL, DISPATCHED_TO_MEMBER, CENTRAL_DROPSHIP, ADJUSTMENT
  quantity      Int       // Box quantity (+/-)
  balanceBefore Int       @default(0)
  balanceAfter  Int       @default(0)
  referenceId   String?   // orderNumber or doc reference
  notes         String?
  createdAt     DateTime  @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt])
  @@map("agent_stock_mutations")
}

model AgentReward {
  id               String    @id @default(uuid())
  agentMemberId    String
  rewardType       String    // CASH_BONUS, PHYSICAL_GOODS
  title            String    // Judul reward e.g. "Bonus Penjualan Semester 1", "Motor Operasional", "Laptop"
  cashAmount       Int       @default(0) // Nilai dana (jika CASH)
  goodsDescription String?   // Rincian fisik barang & nomor seri aset
  goodsValuation   Int       @default(0) // Valuasi perolehan barang untuk pembukuan
  reasonNotes      String    // Alasan penilaian kantor atas kelayakan
  deliveryStatus   String    @default("PENDING") // PENDING, TRANSFERRED, DELIVERED
  awardedBy        String?   // Admin yang memberikan reward
  awardedAt        DateTime  @default(now())
  dispatchedAt     DateTime?

  member Member @relation(fields: [agentMemberId], references: [id], onDelete: Cascade)

  @@index([agentMemberId, awardedAt])
  @@map("agent_rewards")
}

model AgentConfig {
  id                   String   @id @default("default")
  minimumRestockBox    Int      @default(10) // Minimal order pasokan grosir kantor (default 10 box)
  defaultDiscountType  String   @default("PERCENTAGE") // PERCENTAGE or FLAT_PER_BOX
  defaultDiscountValue Float    @default(15.0) // 15%
  updatedAt            DateTime @updatedAt
  updatedBy            String?

  @@map("agent_configs")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique // e.g. "DEFAULT_AGENT_MOQ", "PRIMARY_BANK_ACCOUNT", "MIN_WITHDRAWAL"
  value       String   // Plain string or JSON value
  group       String   @default("GENERAL") // GENERAL, FINANCIAL, AGENT, LOGISTICS
  description String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

