# VARENA Platform — Production Environment Variables Template
# Copy this file to .env and fill in all values before deploying

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://varena_user:CHANGE_ME@localhost:5432/varena_db?schema=public"

# ── Application ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="VARENA"
NEXT_PUBLIC_APP_TAGLINE="Grow Together. Build Value."
NEXT_PUBLIC_APP_URL="https://your-domain.com"
NODE_ENV="production"

# ── Security ─────────────────────────────────────────────────────────────────
# WAJIB: Ganti dengan string random minimal 64 karakter
JWT_SECRET="CHANGE_ME_USE_A_LONG_RANDOM_STRING_AT_LEAST_64_CHARS"

# ── Payment Gateway (Option A: Xendit/Midtrans) ───────────────────────────────
PAYMENT_GATEWAY_ENABLED=false
PAYMENT_GATEWAY_PROVIDER=xendit
XENDIT_WEBHOOK_SECRET=
XENDIT_SECRET_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# ── Payout / Disbursement Gateway (Xendit / Pihak Ketiga) ─────────────────────
# Aktifkan pencairan instan: set ENABLE_XENDIT_PAYOUT=true + isi XENDIT_SECRET_KEY
# Kebijakan: Potongan Admin 10% + Biaya Transfer Rp5.000
ENABLE_XENDIT_PAYOUT=false
XENDIT_CALLBACK_TOKEN=
XENDIT_SANDBOX=false

# ── Bank Mutation Detection (Option B: Moota/CekMutasi) ─────────────────────
BANK_MUTATION_ENABLED=false
MOOTA_API_KEY=
MOOTA_BANK_ACCOUNT_ID=
CEKMUTASI_API_KEY=

# ── WhatsApp Broadcast ────────────────────────────────────────────────────────
WHATSAPP_ENABLED=false
WA_GATEWAY_URL=
WA_GATEWAY_TOKEN=
WA_SENDER_NUMBER=

# ── Shipping Integration (Biteship) ───────────────────────────────────────────
SHIPPING_API_ENABLED=false
BITESHIP_API_KEY=
BITESHIP_ORIGIN_LAT=-6.2088
BITESHIP_ORIGIN_LNG=106.8456
BITESHIP_ORIGIN_ADDRESS=Jakarta Pusat
