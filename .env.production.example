# VARENA Direct Selling Enterprise Platform
# Production Environment Configuration (PostgreSQL & High-Concurrency Security)

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL 15+ / 16+ / 17+)
# -----------------------------------------------------------------------------
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public&connection_limit=20&pool_timeout=30
DATABASE_URL="postgresql://varena_user:SUPER_STRONG_PASSWORD_HERE@localhost:5432/varena_db?schema=public&connection_limit=25&pool_timeout=30&connect_timeout=10"

# Optional: Direct connection URL for migrations when using PgBouncer / Supabase pooling
# DIRECT_URL="postgresql://varena_user:SUPER_STRONG_PASSWORD_HERE@localhost:5432/varena_db?schema=public"

# -----------------------------------------------------------------------------
# APPLICATION METADATA & HOSTING
# -----------------------------------------------------------------------------
NODE_ENV="production"
PORT=3000
NEXT_PUBLIC_APP_NAME="VARENA"
NEXT_PUBLIC_APP_TAGLINE="Grow Together. Build Value."
NEXT_PUBLIC_BASE_URL="https://varena.co.id"

# -----------------------------------------------------------------------------
# SECURITY & AUTHENTICATION SECRETS
# -----------------------------------------------------------------------------
# Generate strong 64-character secret using: openssl rand -base64 48
APP_SECRET="replace-with-a-very-long-and-secure-random-string-at-least-64-characters"
JWT_SECRET="replace-with-another-unique-jwt-signing-key-for-stateless-sessions"

# -----------------------------------------------------------------------------
# RATE LIMITING & DDOS THRESHOLDS (Edge Proxy & In-Memory Store)
# -----------------------------------------------------------------------------
# For multi-server clusters, connect to Redis / Upstash
REDIS_URL="" # e.g. redis://default:token@cluster.upstash.io:6379
RATE_LIMIT_GLOBAL_MAX=100     # Max requests per 10s per IP (DDoS defense)
RATE_LIMIT_LOGIN_MAX=5        # Max failed attempts before 15-minute lockout
RATE_LIMIT_CHECKOUT_MAX=20    # Max orders per 5 minutes per IP
RATE_LIMIT_WITHDRAWAL_MAX=5   # Max payout requests per 10 minutes per member

# -----------------------------------------------------------------------------
# LOGGING & AUDIT TRAIL
# -----------------------------------------------------------------------------
AUDIT_LOG_RETENTION_DAYS=60
LOG_LEVEL="error" # error | warn | info | debug
